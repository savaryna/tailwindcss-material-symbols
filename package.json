{
  "name": "@savaryna/tailwindcss-material-symbols-workspace",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:demo": "pnpm --filter @savaryna/tailwindcss-material-symbols-demo dev",
    "dev:plugin": "pnpm --filter @savaryna/tailwindcss-material-symbols dev",
    "build": "pnpm -r build",
    "build:demo": "pnpm --filter @savaryna/tailwindcss-material-symbols-demo build",
    "build:plugin": "pnpm --filter @savaryna/tailwindcss-material-symbols build",
    "publish:plugin": "pnpm --filter @savaryna/tailwindcss-material-symbols publish --access public",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "check": "pnpm -r check",
    "check:format": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.3"
  }
}
