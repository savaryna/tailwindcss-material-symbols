---
type Props = {
  code: string;
  mark?: string;
};

const { code, mark = '' } = Astro.props;
---

<div
  class:list={[
    'not-prose relative w-full flex-grow rounded border px-2 py-1 text-xs sm:text-sm',
    {
      'border-blue-100 bg-blue-50 text-blue-700': mark,
      'dark:border-blue-600 dark:bg-blue-700 dark:text-blue-50': mark,
    },
    {
      'border-gray-100 bg-gray-50': !mark,
      'dark:border-gray-800 dark:bg-gray-900': !mark,
    },
  ]}
>
  <pre class="overflow-x-auto pr-16">{code}</pre>
  <div
    class:list={[
      'pointer-events-none absolute right-0 top-0 min-h-full min-w-16 rounded py-1 pl-8 pr-2',
      'bg-gradient-to-l from-gray-50 from-40% dark:from-gray-900',
    ]}
  >
    {mark}
  </div>
</div>
