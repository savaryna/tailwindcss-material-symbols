{
  "type": "module",
  "name": "@savaryna/tailwindcss-material-symbols",
  "version": "1.3.0",
  "license": "MIT",
  "author": "Alex Tofan",
  "description": "🌀 A Tailwind CSS plugin that simplifies working with Google's Material Symbols font by providing `icon` utility classes for easy icon integration and styling.",
  "homepage": "https://savaryna.github.io/tailwindcss-material-symbols/",
  "bugs": {
    "url": "https://github.com/savaryna/tailwindcss-material-symbols/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savaryna/tailwindcss-material-symbols.git",
    "directory": "packages/tailwindcss-material-symbols"
  },
  "keywords": [
    "tailwindcss",
    "plugin",
    "tailwindcss plugin",
    "material symbols",
    "material icons"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "style": "./dist/index.css",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "check": "pnpm --parallel check:*",
    "check:types": "tsc --noEmit",
    "check:exports": "attw --pack .",
    "test": "pnpm publish  --access public --no-git-checks --dry-run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.15.4",
    "@types/node": "^22.16.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.17"
  }
}
